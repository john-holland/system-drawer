FROM python:3.12-slim
WORKDIR /app
COPY Scripts/continuum_api/requirements.txt Scripts/continuum_api/requirements.txt
RUN pip install --no-cache-dir -r Scripts/continuum_api/requirements.txt pyyaml
COPY Scripts /app/Scripts
COPY telecom /app/telecom
ENV PYTHONPATH=/app/Scripts
EXPOSE 5050
CMD ["python", "Scripts/continuum_api/server.py", "/data/continuum.db"]
